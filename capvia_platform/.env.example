# ==============================================================================
# CAPVIA SYSTEM-WIDE ENVIRONMENT VARIABLES CATALOG (.env.example)
# ==============================================================================
# This file serves as the master catalog and reference point for all environment
# variables across all 7 services in the CAPVIA Capability-Based Hiring Platform.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. CENTRAL API GATEWAY (capvia_platform)
# ──────────────────────────────────────────────────────────────────────────────

# DATABASE_URL
# Description: PostgreSQL connection string using the asyncpg driver.
# Required: YES
# Default: None
# Example: postgresql+asyncpg://neondb_owner:your_password_here@ep-your-project-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?ssl=require
# Used by: capvia_platform/core/config.py
# Where referenced: capvia_platform/core/config.py:L24, capvia_platform/api/dependencies.py:L12
DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password_here@ep-your-project-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# REDIS_URL
# Description: TLS/SSL-enabled Redis URL for session storage, temporary keys, and rate limits.
# Required: YES
# Default: redis://localhost:6379/0
# Example: rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379
# Used by: capvia_platform/core/config.py, capvia_platform/middleware/rate_limit.py
# Where referenced: capvia_platform/core/config.py:L26, capvia_platform/main.py:L20
REDIS_URL=rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379

# ENVIRONMENT
# Description: Active execution environment (development/production/testing).
# Required: YES
# Default: development
# Example: production
# Used by: capvia_platform/core/config.py
# Where referenced: capvia_platform/core/config.py:L28, capvia_platform/middleware/error_handler.py:L22
ENVIRONMENT=production

# NEXT_PUBLIC_API_URL
# Description: The canonical entrypoint URL of the Central Gateway API.
# Required: YES
# Default: http://localhost:8000/api/v1
# Example: https://api.capvia.in/api/v1
# Used by: capvia_platform/core/config.py
# Where referenced: capvia_platform/core/config.py:L30
NEXT_PUBLIC_API_URL=https://api.capvia.in/api/v1

# ATS_ENGINE_URL
# Description: Endpoint for the outbound SBERT-powered ATS Resume subsystem.
# Required: YES
# Default: http://localhost:8001
# Example: https://ats-api.capvia.in
# Used by: capvia_platform/services/ats_connector.py
# Where referenced: capvia_platform/core/config.py:L32, capvia_platform/services/ats_connector.py:L15
ATS_ENGINE_URL=https://ats-api.capvia.in

# SIMULATION_ENGINE_URL
# Description: Endpoint for the coding simulation sandbox evaluator subsystem.
# Required: YES
# Default: http://localhost:8002
# Example: https://simulation-api.capvia.in
# Used by: capvia_platform/services/simulation_connector.py
# Where referenced: capvia_platform/core/config.py:L34, capvia_platform/services/simulation_connector.py:L16
SIMULATION_ENGINE_URL=https://simulation-api.capvia.in

# INTERVIEW_ENGINE_URL
# Description: Endpoint for the AI speech and video analysis evaluation server.
# Required: YES
# Default: http://localhost:8765
# Example: https://interview-api.capvia.in
# Used by: capvia_platform/services/interview_connector.py
# Where referenced: capvia_platform/core/config.py:L36, capvia_platform/services/interview_connector.py:L18
INTERVIEW_ENGINE_URL=https://interview-api.capvia.in

# SECRET_KEY
# Description: Cryptographic secret key used to sign JWTs issued by the gateway.
# Required: YES
# Default: supersecretkey_change_in_production
# Example: d5b4c1a798ef56b98e1f0e4b85c9a7d362f1e09c8ab543ef7a8b9c6d5e4f3a2b
# Used by: capvia_platform/utils/auth.py
# Where referenced: capvia_platform/core/config.py:L38, capvia_platform/utils/auth.py:L35
SECRET_KEY=supersecretkey_change_in_production_32_characters_minimum

# SUPABASE_URL
# Description: Supabase project API gateway endpoint URL.
# Required: YES
# Default: None
# Example: https://your_supabase_project_ref.supabase.co
# Used by: capvia_platform/services/report_service.py
# Where referenced: capvia_platform/core/config.py:L40
SUPABASE_URL=https://your_supabase_project_ref.supabase.co

# SUPABASE_PUBLISHABLE_KEY
# Description: Supabase anon public API key for storage reads.
# Required: YES
# Default: None
# Example: sb_publishable_your_supabase_anon_key_here
# Used by: capvia_platform/services/report_service.py
# Where referenced: capvia_platform/core/config.py:L42
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_supabase_anon_key_here

# SUPABASE_SECRET_KEY
# Description: Supabase service_role bypass key for admin storage writes.
# Required: YES
# Default: None
# Example: sb_secret_your_supabase_service_role_key_here
# Used by: capvia_platform/services/report_service.py
# Where referenced: capvia_platform/core/config.py:L44
SUPABASE_SECRET_KEY=sb_secret_your_supabase_service_role_key_here

# RESEND_API_KEY
# Description: Transactional email sending token from Resend.
# Required: YES
# Default: None
# Example: re_your_resend_api_key_here
# Used by: capvia_platform/services/email_service.py
# Where referenced: capvia_platform/core/config.py:L46
RESEND_API_KEY=re_your_resend_api_key_here

# SENTRY_DSN
# Description: DSN for error reporting in backend gateway.
# Required: OPTIONAL
# Default: None
# Example: https://your_sentry_dsn_here
# Used by: capvia_platform/main.py
# Where referenced: capvia_platform/core/config.py:L48
SENTRY_DSN=https://your_sentry_dsn_here


# ──────────────────────────────────────────────────────────────────────────────
# 2. RECRUITER PORTAL FRONTEND (capvia_platform/frontend)
# ──────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_SUPABASE_URL
# Description: Supabase URL for client-side storage queries.
# Required: YES
# Default: None
# Example: https://your_supabase_project_ref.supabase.co
# Used by: capvia_platform/frontend/src/lib/supabase.ts
# Where referenced: capvia_platform/frontend/src/lib/supabase.ts:L4
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project_ref.supabase.co

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Description: Client-facing Supabase token.
# Required: YES
# Default: None
# Example: sb_publishable_your_supabase_anon_key_here
# Used by: capvia_platform/frontend/src/lib/supabase.ts
# Where referenced: capvia_platform/frontend/src/lib/supabase.ts:L5
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_supabase_anon_key_here

# UPSTASH_REDIS_REST_URL
# Description: REST connection URL for Upstash serverless Redis (Server Components only).
# Required: YES
# Default: None
# Example: https://your-redis-host.upstash.io
# Used by: capvia_platform/frontend/src/services/api.ts
# Where referenced: capvia_platform/frontend/src/services/api.ts:L152
UPSTASH_REDIS_REST_URL=https://your-redis-host.upstash.io

# UPSTASH_REDIS_REST_TOKEN
# Description: Authorization token for Upstash Redis REST calls.
# Required: YES
# Default: None
# Example: your_upstash_redis_token_here
# Used by: capvia_platform/frontend/src/services/api.ts
# Where referenced: capvia_platform/frontend/src/services/api.ts:L153
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# NEXT_PUBLIC_SENTRY_DSN
# Description: DSN for error telemetry in Next.js.
# Required: OPTIONAL
# Default: None
# Example: https://your_sentry_dsn_here
# Used by: capvia_platform/frontend/sentry.client.config.ts
# Where referenced: capvia_platform/frontend/sentry.client.config.ts:L15
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here

# NEXT_PUBLIC_API_URL
# Description: Endpoint for Next.js to call Central Gateway API.
# Required: YES
# Default: http://localhost:8000/api/v1
# Example: https://api.capvia.in/api/v1
# Used by: capvia_platform/frontend/src/services/api.ts
# Where referenced: capvia_platform/frontend/src/services/api.ts:L4
NEXT_PUBLIC_API_URL=https://api.capvia.in/api/v1

# NODE_ENV
# Description: Environment marker to compile optimisations.
# Required: YES
# Default: development
# Example: production
# Used by: next-cli compiler
# Where referenced: next.config.mjs:L22
NODE_ENV=production


# ──────────────────────────────────────────────────────────────────────────────
# 3. ATS BACKEND (ats_resume/backend)
# ──────────────────────────────────────────────────────────────────────────────

# SECRET_KEY
# Description: Flask/FastAPI backend cryptographic secret.
# Required: YES
# Default: your-super-secret-development-key
# Example: your_cryptographic_secret_key_here
# Used by: ats_resume/backend/config.py
SECRET_KEY=your-super-secret-production-key-here-32-chars

# DATABASE_URL
# Description: Relational DB for ATS metadata logs.
# Required: YES
# Default: postgresql+asyncpg://postgres:pass@localhost:5432/ats_db
# Example: postgresql+asyncpg://neondb_owner:your_password_here@ep-your-project-pooler.c-2.ap-southeast-1.aws.neon.tech/ats_db?ssl=require
# Used by: ats_resume/backend/db/postgres.py
DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password_here@ep-your-project-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# MONGO_URL
# Description: MongoDB connection URI for parsing history logs.
# Required: YES
# Default: mongodb://localhost:27017
# Example: mongodb+srv://admin:your_mongodb_password_here@your-mongodb-cluster.mongodb.net/capvia_ats?retryWrites=true&w=majority
# Used by: ats_resume/backend/db/mongodb.py
MONGO_URL=mongodb://localhost:27017

# MONGO_DB_NAME
# Description: MongoDB database target schema folder name.
# Required: YES
# Default: capvia_ats
# Example: capvia_ats_prod
# Used by: ats_resume/backend/db/mongodb.py
MONGO_DB_NAME=capvia_ats

# REDIS_URL
# Description: Redis instance target database.
# Required: YES
# Default: redis://localhost:6379/0
# Example: rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379
# Used by: ats_resume/backend/db/redis_client.py
REDIS_URL=rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379

# CELERY_BROKER_URL
# Description: Celery queues broker queue connection channel index.
# Required: YES
# Default: redis://localhost:6379/1
# Example: rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379/1
# Used by: ats_resume/backend/workers/celery_app.py
# Where referenced: ats_resume/backend/config.py
CELERY_BROKER_URL=rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379/1

# CELERY_RESULT_BACKEND
# Description: Celery tasks execution results caching DB index.
# Required: YES
# Default: redis://localhost:6379/2
# Example: rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379/2
# Used by: ats_resume/backend/workers/celery_app.py
# Where referenced: ats_resume/backend/config.py
CELERY_RESULT_BACKEND=rediss://default:your_redis_token_here@your-redis-host.upstash.io:6379/2

# AWS_ACCESS_KEY_ID
# Description: Optional AWS creds for S3 storage (Supabase S3 compatibility).
# Required: OPTIONAL
# Default: ""
# Example: AKIAIOSFODNN7EXAMPLE
# Used by: ats_resume/backend/services/storage.py
AWS_ACCESS_KEY_ID=""

# AWS_SECRET_ACCESS_KEY
# Description: AWS secret token companion key.
# Required: OPTIONAL
# Default: ""
# Example: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Used by: ats_resume/backend/services/storage.py
AWS_SECRET_ACCESS_KEY=""

# AWS_REGION
# Description: AWS geographic deployment target region.
# Required: YES
# Default: ap-south-1
# Example: ap-southeast-1
# Used by: ats_resume/backend/services/storage.py
AWS_REGION=ap-south-1

# AWS_S3_BUCKET
# Description: S3 bucket target location name.
# Required: YES
# Default: capvia-resumes-dev
# Example: capvia-resumes-prod
# Used by: ats_resume/backend/services/storage.py
AWS_S3_BUCKET=capvia-resumes-prod


# ──────────────────────────────────────────────────────────────────────────────
# 4. ATS FRONTEND (ats_resume/frontend)
# ──────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_API_URL
# Description: Endpoint for Next.js to call ATS backend.
# Required: YES
# Default: http://localhost:8001
# Example: https://ats-api.capvia.in
# Used by: ats_resume/frontend/lib/api.ts
NEXT_PUBLIC_API_URL=https://ats-api.capvia.in

# NEXT_PUBLIC_APP_NAME
# Description: Public name displayed in titles/branding.
# Required: YES
# Default: "CAPVIA ATS"
# Example: "CAPVIA ATS"
# Used by: ats_resume/frontend/app/layout.tsx
NEXT_PUBLIC_APP_NAME="CAPVIA ATS"


# ──────────────────────────────────────────────────────────────────────────────
# 5. CODING SIMULATION BACKEND (ai_simulation/backend)
# ──────────────────────────────────────────────────────────────────────────────

# POSTGRES_SERVER
# Description: Relational DB server URL endpoint.
# Required: YES
# Default: localhost
# Example: ep-your-project-pooler.c-2.ap-southeast-1.aws.neon.tech
# Used by: ai_simulation/backend/app/db/session.py
POSTGRES_SERVER=ep-your-project-pooler.c-2.ap-southeast-1.aws.neon.tech

# POSTGRES_USER
# Description: Relational DB user name.
# Required: YES
# Default: postgres
# Example: neondb_owner
# Used by: ai_simulation/backend/app/db/session.py
POSTGRES_USER=neondb_owner

# POSTGRES_PASSWORD
# Description: Relational DB authentication password.
# Required: YES
# Default: your_password_here
# Example: your_neon_password_here
# Used by: ai_simulation/backend/app/db/session.py
POSTGRES_PASSWORD=your_neon_password_here

# POSTGRES_DB
# Description: Database schema target name.
# Required: YES
# Default: ai_simulation
# Example: neondb
# Used by: ai_simulation/backend/app/db/session.py
POSTGRES_DB=neondb

# POSTGRES_PORT
# Description: DB Server listening port connection channel.
# Required: YES
# Default: 5432
# Example: 5432
# Used by: ai_simulation/backend/app/db/session.py
POSTGRES_PORT=5432

# REDIS_HOST
# Description: Hostname of redis server.
# Required: YES
# Default: localhost
# Example: your-redis-host.upstash.io
# Used by: ai_simulation/backend/app/core/config.py
REDIS_HOST=your-redis-host.upstash.io

# REDIS_PORT
# Description: Redis Server listening port.
# Required: YES
# Default: 6379
# Example: 6379
# Used by: ai_simulation/backend/app/core/config.py
REDIS_PORT=6379

# REDIS_DB
# Description: Redis database index.
# Required: YES
# Default: 0
# Example: 0
# Used by: ai_simulation/backend/app/core/config.py
REDIS_DB=0

# OPENAI_API_KEY
# Description: AI processing engine connection token.
# Required: YES
# Default: your-openai-api-key-here
# Example: sk-proj-your_openai_key_here
# Used by: ai_simulation/backend/app/services/ai_service.py
OPENAI_API_KEY=your-openai-api-key-here

# OPENAI_MODEL
# Description: Model identifier used for code evaluations.
# Required: YES
# Default: gpt-4
# Example: gpt-4o-mini
# Used by: ai_simulation/backend/app/services/ai_service.py
OPENAI_MODEL=gpt-4


# ──────────────────────────────────────────────────────────────────────────────
# 6. CODING SIMULATION FRONTEND (ai_simulation/frontend)
# ──────────────────────────────────────────────────────────────────────────────

# VITE_API_URL
# Description: Endpoint for Simulation Vite client to reach Simulation Backend.
# Required: YES
# Default: http://localhost:8002/api/v1
# Example: https://simulation-api.capvia.in/api/v1
# Used by: ai_simulation/frontend/src/services/api.ts
VITE_API_URL=https://simulation-api.capvia.in/api/v1
